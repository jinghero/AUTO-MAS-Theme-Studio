{
  "name": "auto-mas-theme-studio",
  "version": "1.5.0",
  "private": true,
  "description": "MAS 主题工坊与桌宠工具源码",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "prestart": "npm run compile",
    "start": "node --experimental-strip-types run.cts",
    "build:app": "node --experimental-strip-types build-app.cts",
    "build:compat": "npm run build:app",
    "build:preview": "node --experimental-strip-types build-preview.cts",
    "compile": "npm run build:app && npm run build:preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.scripts.json && vue-tsc -p tsconfig.preview.json",
    "prebuild": "npm run quality && npm run compile",
    "build": "node --experimental-strip-types build.cts",
    "predocs:images": "npm run compile",
    "docs:images": "node --experimental-strip-types capture-guide.cts",
    "precheck": "npm run compile",
    "check": "node --experimental-strip-types verify-all.cts --suite=verify",
    "precheck:mas": "npm run compile",
    "check:mas": "node --experimental-strip-types verify-all.cts --suite=verify-mas",
    "precheck:ai": "npm run compile",
    "check:ai": "node --experimental-strip-types verify-all.cts --suite=verify-ai",
    "precheck:icons": "npm run compile",
    "check:icons": "node --experimental-strip-types verify-all.cts --suite=verify-icons",
    "precheck:titles": "npm run compile",
    "check:titles": "node --experimental-strip-types verify-all.cts --suite=verify-titles",
    "check:packaged": "node --experimental-strip-types verify-all.cts --packaged",
    "pretest": "npm run quality && npm run compile",
    "test": "node --experimental-strip-types verify-all.cts",
    "update:compat": "node --experimental-strip-types setup.cts",
    "update:preview": "node --experimental-strip-types prepare-preview.cts",
    "precheck:extra": "npm run compile",
    "check:extra": "node --experimental-strip-types verify-all.cts --suite=verify-extra",
    "precheck:quality": "npm run compile",
    "check:quality": "node --experimental-strip-types verify-all.cts --suite=quality",
    "precheck:packaged": "npm run build:app",
    "lint": "eslint src preview-src --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,cts}\" \"*.{cts,mts}\" \"tools/**/*.mts\" \"tests/**/*.{ts,mts}\" \"preview-src/**/*.{ts,vue}\" \"tsconfig*.json\" \"package.json\" \"eslint.config.mts\"",
    "format:check": "prettier --check \"src/**/*.{ts,cts}\" \"*.{cts,mts}\" \"tools/**/*.mts\" \"tests/**/*.{ts,mts}\" \"preview-src/**/*.{ts,vue}\" \"tsconfig*.json\" \"package.json\" \"eslint.config.mts\"",
    "quality": "npm run typecheck && npm run lint && npm run format:check",
    "precheck:drafts": "npm run compile",
    "check:drafts": "node --experimental-strip-types verify-all.cts --suite=verify-drafts"
  },
  "dependencies": {
    "adm-zip": "0.5.17"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@electron/asar": "3.4.1",
    "@playwright/test": "1.64.0",
    "@types/adm-zip": "0.5.8",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.5",
    "ant-design-vue": "4.2.6",
    "electron": "37.10.3",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "jiti": "2.7.0",
    "marked": "18.1.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vue": "3.5.32",
    "vue-i18n": "11.4.10",
    "vue-router": "4.6.4",
    "vue-tsc": "3.3.13"
  }
}
